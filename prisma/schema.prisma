generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// UserRole lives in the public schema because it is used by Profile and
// TenantInvite, both of which are public-schema models.
enum UserRole {
  ADMIN
  MANAGER
  TECHNICIAN
}

// One row per authenticated person. Credentials, email, and OAuth flows live
// in Supabase Auth (auth.users). Profile is the public-schema counterpart.
// supabaseUserId is the join key to auth.users.id.
// Relations to Technician and PropertyNote are NOT defined here — those models
// live in the per-tenant schema and cannot have FK references back to this
// public-schema table via Prisma. profileId on those models is enforced by
// application logic, not a DB constraint.
model Profile {
  id             String    @id @default(cuid())
  supabaseUserId String    @unique
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  role           UserRole
  name           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
}

// One row per business (window cleaning company). Created on admin signup.
// schemaName is the Postgres schema that holds all operational data for this
// tenant (e.g. "t_cm8abc123def456").
model Tenant {
  id         String    @id @default(cuid())
  schemaName String    @unique
  createdAt  DateTime  @default(now())
  profiles   Profile[]
}

// Pending invitation for a TECHNICIAN (or MANAGER) to join a tenant.
// The inviting admin creates this; the invitee accepts via token.
// One TenantInvite per email per tenant — duplicate invites are prevented
// by application logic (check for existing unaccepted invite before creating).
model TenantInvite {
  id            String    @id @default(cuid())
  tenantId      String
  email         String
  role          UserRole  @default(TECHNICIAN)
  token         String    @unique @default(cuid())
  expiresAt     DateTime
  acceptedAt    DateTime?
  technicianId  String?
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([token])
}
