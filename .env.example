# Supabase Postgres connection. Copy to `.env` and fill in real values.
# Prisma reads both from schema.prisma's datasource block.

# Runtime — transaction-mode pooler (port 6543).
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations (Prisma CLI) — session-mode pooler / direct connection (port 5432).
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<REGION>.pooler.supabase.com:5432/postgres"

# Auth: JWTs are verified against the Supabase project's JWKS endpoint (ES256,
# asymmetric). Set to https://<PROJECT_REF>.supabase.co/auth/v1 for your project.
SUPABASE_ISSUER="https://<PROJECT_REF>.supabase.co/auth/v1"

# Supabase service role key — used only for sending staff invite emails via
# the Supabase Auth Admin API. Never expose this in the frontend.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Base URL of the frontend app — appended with /accept-invite?token=<token>.
INVITE_BASE_URL="https://app.yourdomain.com"

# Allowed CORS origins — comma-separated, no trailing slash. Every entry is an
# accepted CORS origin; the FIRST entry is the canonical app URL used for
# redirects (Stripe/GHL OAuth) and invite links.
#   prod host: "https://www.roundflow.ai"
#   dev host:  "https://dev.roundflow.ai,https://www.roundflow.ai"
FRONTEND_URL="https://www.roundflow.ai,https://dev.roundflow.ai"

# Supabase project URL — used for Storage signed upload URLs and public file URLs.
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"

# Supabase Storage bucket name for visit before/after photos.
VISIT_PHOTOS_BUCKET="visit-photos"

# Public API base URL — used to build OAuth callback URLs (no trailing slash).
PUBLIC_API_URL="https://api.yourdomain.com"

# GoHighLevel marketplace app credentials (app-level, not per-tenant).
# Stripe Connect — platform-level credentials.
STRIPE_CLIENT_ID="ca_your-stripe-connect-client-id"
STRIPE_SECRET_KEY="sk_live_your-stripe-platform-secret-key"

# Stripe Connect webhook — ONE platform-level endpoint (Dashboard: Developers
# -> Webhooks -> Add endpoint -> "Listen to events on Connected accounts"),
# created once in RoundFlow's own Stripe account. Receives events for every
# tenant's connected Stripe account automatically, tagged by `event.account`.
# This is NOT per-tenant — do not confuse with a connected account's own key.
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_your-platform-connect-webhook-secret"

GHL_CLIENT_ID="your-ghl-client-id"
GHL_CLIENT_SECRET="your-ghl-client-secret"

# Gotenberg HTML->PDF render service for invoice PDFs. Leave unset to disable
# (GET /invoices/:id/pdf then returns 501). Locally: run the container on a
# non-3000 host port (the API uses 3000) -> http://localhost:3001. On EC2 the
# app reaches it by container name on a shared docker network -> http://gotenberg:3000.
GOTENBERG_URL="http://localhost:3001"

# Serve /docs (Swagger UI) and /openapi.json when NODE_ENV=production.
# Closed by default in production (404); always open outside production.
# EXPOSE_API_DOCS="true"

# ACT-10: server-side Google Geocoding API key (a SEPARATE key from the browser
# Maps JS key: Geocoding API only, restricted by server IP). Unset = property
# pins use postcodes.io postcode centres only (stored as POSTCODE_FALLBACK) and
# startup logs a warning.
# GOOGLE_MAPS_GEOCODING_API_KEY=""
# Max Google geocode calls per process per UTC day (default 2000).
# GEOCODE_DAILY_LIMIT="2000"

# ---- Wave 2B-1 (hardening) ----
# Rate limits, per client IP, in-memory per process. RATE_LIMIT_DISABLED=true turns them all off.
# Defaults: 600/min global (never /health), 10/hour POST /auth/signup, 20/min public invite
# lookup + accept, 300/min per webhook source (stripe, gocardless, ghl). Over the limit -> 429
# RATE_LIMITED with Retry-After.
# RATE_LIMIT_DISABLED="false"
# RATE_LIMIT_GLOBAL_PER_MIN="600"
# RATE_LIMIT_SIGNUP_PER_HOUR="10"
# RATE_LIMIT_INVITE_PER_MIN="20"
# RATE_LIMIT_WEBHOOK_PER_MIN="300"
# Proxy hops in front of the API (for the real client IP in rate limits). Default 1 in production, 0 elsewhere.
# TRUST_PROXY="1"
# Max JSON request body (default 100kb). Larger -> 413 PAYLOAD_TOO_LARGE.
# JSON_BODY_LIMIT="100kb"
# Timeout for outbound HTTP calls (GHL, Expo push, Gotenberg, Supabase email/storage), ms, min 1000. Default 15000 (PDF render 60000).
# OUTBOUND_TIMEOUT_MS="15000"

# ---- Wave 2B-2 (native customer email via Amazon SES; GHL is now an optional SMS add-on) ----
# Region of the SES account and the shared sending address on the RoundFlow-owned, SES-verified subdomain
# (tier 1: "<Business name>" <SES_FROM_DOMAIN_ADDRESS>). Unset = customer email is unavailable (CHANNEL_UNAVAILABLE).
# SES_REGION="eu-west-2"
# SES_FROM_DOMAIN_ADDRESS="notifications@mail.roundflow.ai"
# Configuration set that publishes Delivery/Bounce/Complaint events to SNS -> POST {PUBLIC_API_URL}/webhooks/ses
# SES_CONFIGURATION_SET="roundflow-events"
# Optional: only accept SNS messages from this topic.
# SES_SNS_TOPIC_ARN="arn:aws:sns:eu-west-2:123456789012:roundflow-ses-events"
# Optional static credentials of the dedicated IAM user (unset = default AWS credential chain / instance role).
# SES_ACCESS_KEY_ID=""
# SES_SECRET_ACCESS_KEY=""
# "true" switches native customer email off everywhere (Supabase auth emails are not affected).
# EMAIL_DISABLED="false"
# /settings/email/* (domain verification, test email) per IP per hour.
# RATE_LIMIT_EMAIL_ADMIN_PER_HOUR="60"

# ---- Flo AI (admin-only, read-only assistant; included in the SaaS price, platform-owned cost control) ----
# Unset = Flo is disabled (GET /flo/status says so, POST /flo/chat answers 503 FLO_UNAVAILABLE). Never logged, never sent to the browser.
# ANTHROPIC_API_KEY=""
# Optional: point the SDK at a mock server or proxy.
# ANTHROPIC_BASE_URL=""
# Kill switch (default true).
# FLO_ENABLED="true"
# Model ids per mode and for the scope-gate classifier (a model change needs no code deploy).
# FLO_MODEL_THOROUGH="claude-opus-5-5"
# FLO_MODEL_BALANCED="claude-sonnet-5-5"
# FLO_MODEL_QUICK="claude-haiku-5-5"
# FLO_MODEL_SCOPE="claude-haiku-5-5"
# Answered questions per tenant per tenant-local day. PLATFORM-OWNED: not exposed to or editable by tenants (default 100).
# FLO_DAILY_LIMIT_PER_TENANT="100"
# Declined messages per admin per day before 429 FLO_DECLINE_LIMIT (default 30).
# FLO_DECLINE_LIMIT_PER_DAY="30"
# Flo requests per admin profile per minute (keyed on profile id, not IP) (default 20).
# RATE_LIMIT_FLO_PER_MIN="20"
# Whole-request budget in ms (default 90000, minimum 5000).
# FLO_TIMEOUT_MS="90000"
# Days a conversation is kept before the nightly purge (default 90).
# FLO_RETENTION_DAYS="90"
