# Supabase Postgres connection. Copy to `.env` and fill in real values.
# Prisma reads both from schema.prisma's datasource block.

# Runtime — transaction-mode pooler (port 6543).
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations (Prisma CLI) — session-mode pooler / direct connection (port 5432).
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<REGION>.pooler.supabase.com:5432/postgres"

# Auth: JWTs are verified against the Supabase project's JWKS endpoint (ES256,
# asymmetric). Set to https://<PROJECT_REF>.supabase.co/auth/v1 for your project.
SUPABASE_ISSUER="https://<PROJECT_REF>.supabase.co/auth/v1"

# Email (Resend). Get an API key at https://resend.com.
RESEND_API_KEY="re_..."

# The sender address shown to invitees. Must be a verified domain in Resend.
EMAIL_FROM="RoundFlow <invites@yourdomain.com>"

# Base URL of the frontend app — appended with /accept-invite?token=<token>.
INVITE_BASE_URL="https://app.yourdomain.com"

# Allowed CORS origin. Must match the frontend URL exactly (no trailing slash).
FRONTEND_URL="https://app.yourdomain.com"
