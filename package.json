{
  "name": "roundflow",
  "version": "0.1.0",
  "private": true,
  "description": "RoundFlow — Phase 1 field service management SaaS (backend/data layer)",
  "scripts": {
    "postinstall": "prisma generate && prisma generate --schema prisma/tenant/schema.prisma",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && npm run typecheck && tsc -p tsconfig.build.json && cp -r src/generated dist/ && cp -r prisma/tenant dist/prisma-tenant",
    "prisma:generate": "prisma generate && prisma generate --schema prisma/tenant/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.6",
    "openapi-types": "^12.1.3",
    "prisma": "6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "lru-cache": "^11.5.2",
    "pg": "^8.22.0",
    "resend": "^6.17.2",
    "swagger-ui-express": "^5.0.1"
  }
}
